# Copy this file to .env and fill in your own values. Never commit .env.
# Your Learn server key, from My APIs in your developer workspace. It stays on your server.
FOREVERLEARNING_API_KEY=
# The API host, ending in /v1.
FOREVERLEARNING_BASE_URL=https://developers-api.foreverlearning.ai/v1
# To test on staging instead:
# FOREVERLEARNING_BASE_URL=https://developers-api-staging.foreverlearning.ai/v1
# Optional: your Learn assignment id, from My APIs. Leave empty if your key has one assignment.
FOREVERLEARNING_ASSIGNMENT_ID=
# The port for your local server.
PORT=3000
